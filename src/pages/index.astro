---
import Base from '../layouts/Base.astro';
import Socials from '../components/Socials.astro';
import { SITE } from '../consts';
---

<Base>
  <section class="hero">
    <img class="avatar rise" src={SITE.avatar} alt={SITE.name} width="256" height="256" />
    <div class="intro rise" style="animation-delay: 0.08s">
      <h1>{SITE.name}</h1>
      <p class="slogan">{SITE.slogan}</p>
    </div>
    <div class="rise" style="animation-delay: 0.16s">
      <Socials />
    </div>
  </section>
</Base>

<style>
  .hero {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 22px;
    padding: 4rem 1.5rem;
    text-align: center;
  }
  .avatar {
    width: 256px;
    height: 256px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--border-strong);
    background: var(--surface);
  }
  .intro h1 {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
  }
  .slogan {
    margin: 6px 0 0;
    color: var(--text-muted);
    font-size: 1.02rem;
  }
</style>
