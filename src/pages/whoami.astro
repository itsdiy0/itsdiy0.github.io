---
import Base from '../layouts/Base.astro';

// Write about yourself here — just edit the paragraphs below.
---

<Base title="whoami" description="A bit about me.">
  <section class="wrap rise">
    <p class="mono">$ whoami</p>
    <h1>Mobin Rajaei</h1>

    <div class="prose">
      <p>
        I'm a developer working mostly in backend and infrastructure. I like
        building things from the ground up and understanding how they fit
        together — from the code, down to the box it runs on.
      </p>
      <p>
        These days a lot of my time goes into a k3s homelab that runs my
        personal projects, and into web platforms for work and the occasional
        client. I care about systems that are simple to reason about and
        boring to operate.
      </p>
      <p>
        This site is where I keep my projects and write about what I'm
        learning. If you want to get in touch, the links are on the
        <a href="/">home page</a>.
      </p>
    </div>
  </section>
</Base>

<style>
  .wrap {
    width: 100%;
    max-width: var(--content-max);
    margin: 0 auto;
    padding: clamp(3rem, 8vh, 6rem) 1.5rem 4rem;
  }
  h1 {
    font-size: clamp(1.7rem, 4vw, 2.4rem);
    margin: 6px 0 0;
  }
  .prose {
    margin-top: 2rem;
    font-size: 1.05rem;
    line-height: 1.75;
  }
  .prose p {
    margin: 0 0 1.2rem;
  }
  .prose :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }
</style>
