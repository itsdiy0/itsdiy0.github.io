---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort((a, b) => {
  if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
  return b.data.date.getTime() - a.data.date.getTime();
});
---

<Base title="projects" description="Things I've built.">
  <section class="wrap">
    <header class="head rise">
      <p class="mono">selected work</p>
      <h1>Projects</h1>
    </header>

    {
      projects.length === 0 ? (
        <p class="empty">No projects yet — add a Markdown file to src/content/projects/.</p>
      ) : (
        <div class="grid rise" style="animation-delay: 0.08s">
          {projects.map((p) => (
            <ProjectCard
              title={p.data.title}
              summary={p.data.summary}
              stack={p.data.stack}
              cover={p.data.cover}
              repo={p.data.repo}
              live={p.data.live}
            />
          ))}
        </div>
      )
    }
  </section>
</Base>

<style>
  .wrap {
    width: 100%;
    max-width: 60rem;
    margin: 0 auto;
    padding: clamp(3rem, 8vh, 6rem) 1.5rem 4rem;
  }
  .head {
    margin-bottom: 2rem;
  }
  .head h1 {
    font-size: clamp(1.7rem, 3.5vw, 2.2rem);
    margin-top: 4px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: 18px;
  }
  .empty {
    color: var(--text-muted);
    font-size: 0.95rem;
  }
</style>
